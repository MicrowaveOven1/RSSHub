{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "hono",
    "outputDirectory": "src",
    "functions": {
        "src/server.mjs": {
            "includeFiles": "./src/templates/**/*.art"
        }
    },
    "rewrites": [
        {
            "source": "/favicon.ico",
            "destination": "/favicon.png"
        },

        {
            "source": "/:path*",
            // "destination": "http://115.29.238.240:1200/:path*"
            "destination": "http://http://47.114.101.128:1200/:path*"
        }
    ]
}
